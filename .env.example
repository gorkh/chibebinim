APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///./data/moviebot.db
CATALOG_PROVIDER=fixture
TMDB_API_KEY=
TMDB_API_BASE_URL=https://api.themoviedb.org/3
# Optional: Telegram-accessible HTTPS URL of an approved TMDB logo (PNG or JPEG).
# TMDB_LOGO_URL=
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT=7
AI_MAX_OUTPUT_TOKENS=500
AI_DAILY_LIMIT=250
CCLOUD_BASE_URL=https://ccloud.sbs/
TELEGRAM_NATIVE_COPY=true
RECOMMENDATION_CANDIDATE_LIMIT=50
RECENT_RECOMMENDATIONS_LIMIT=30
CACHE_TTL_HOURS=168
RANKING_WEIGHTS=[0.35,0.25,0.15,0.15,0.10]
